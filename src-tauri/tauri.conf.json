{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ImageSage",
  "version": "0.4.1",
  "identifier": "com.robmirabelle.imagesage",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:14410",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Image Sage",
        "width": 1360,
        "height": 880,
        "minWidth": 960,
        "minHeight": 640,
        "visible": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "backgroundColor": "#22252f"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": ["icons/icon.ico", "DirectML.dll"],
    "fileAssociations": [
      {
        "ext": ["imagesage"],
        "name": "ImageSage.Document",
        "description": "Image Sage document"
      }
    ],
    "windows": {
      "nsis": {
        "template": "installer.nsi"
      }
    }
  }
}
